generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum Grade {
  GRADE_11
  GRADE_12
}

enum Branch {
  SCIENTIFIC
  LITERARY
}

enum PlanType {
  TRIAL
  MONTHLY
  QUARTERLY
  YEARLY
}

enum VideoStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String?
  grade        Grade?
  branch       Branch?
  passwordHash String?  @map("password_hash")
  role         UserRole @default(STUDENT)
  parentPhone  String?  @map("parent_phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  videoViews    VideoView[]
  teacher       Teacher?
  dailyGoals    DailyGoal[]
  quizResults   QuizResult[]
  studySessions StudySession[]
  cartItems     CartItem[]
  chats         Chat[]         @relation("StudentChats")

  @@map("users")
}

model Teacher {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  name           String
  bio            String?
  avatarUrl      String?  @map("avatar_url")
  commissionRate Float    @default(0.25) @map("commission_rate")
  createdAt      DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects Subject[]
  videos   Video[]
  chats    Chat[]    @relation("TeacherChats")

  @@map("teachers")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  grade     Grade
  branch    Branch
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")
  priceIls  Float    @default(50.0) @map("price_ils")

  teacher Teacher? @relation(fields: [teacherId], references: [id])
  videos  Video[]
  quizzes Quiz[]
  subscriptions SubscriptionSubject[]
  cartItems     CartItem[]

  @@unique([name, grade, branch])
  @@map("subjects")
}

model Video {
  id          String      @id @default(cuid())
  subjectId   String      @map("subject_id")
  teacherId   String?     @map("teacher_id")
  title       String
  description String?
  streamUrl   String?     @map("stream_url")
  durationSec Int         @default(0) @map("duration_sec")
  unitNumber  Int         @default(1) @map("unit_number")
  orderInUnit Int         @default(1) @map("order_in_unit")
  maxViews    Int         @default(3) @map("max_views")
  downloadDays Int        @default(7) @map("download_days")
  status      VideoStatus @default(DRAFT)
  pdfUrl      String?     @map("pdf_url")
  muxUploadId   String?   @map("mux_upload_id")
  muxAssetId    String?   @map("mux_asset_id")
  muxPlaybackId String?   @map("mux_playback_id")
  // none = external URL video, uploading/processing/ready/failed = Mux lifecycle
  videoStatus   String    @default("none") @map("video_status")
  videoDuration Int?      @map("video_duration")
  muxStatus         String?     @map("mux_status")
  muxDuration       Float?      @map("mux_duration")
  muxThumbnail      String?     @map("mux_thumbnail")
  muxStaticMp4Name  String?     @map("mux_static_mp4_name")
  offlineAvailable  Boolean     @default(false) @map("offline_available")
  videoSize         Int?        @map("video_size")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher?    @relation(fields: [teacherId], references: [id])
  videoViews VideoView[]
  chapters   VideoChapter[]
  questions  VideoQuestion[]

  @@map("videos")
}

model VideoView {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  videoId     String   @map("video_id")
  viewCount   Int      @default(0) @map("view_count")
  completed   Boolean  @default(false)
  lastViewed  DateTime @default(now()) @map("last_viewed")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_views")
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  type            PlanType @unique
  nameAr          String   @map("name_ar")
  durationDays    Int      @map("duration_days")
  discountPercent Float    @default(0) @map("discount_percent")
  priceIls        Float    @map("price_ils")
  videosPerSubject Int     @default(10) @map("videos_per_subject")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  startDate DateTime @default(now()) @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  isFrozen  Boolean  @default(false) @map("is_frozen")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])
  subjects SubscriptionSubject[]

  @@map("subscriptions")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, code])
  @@map("otp_codes")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model DailyGoal {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  completed Boolean  @default(false)
  dueDate   DateTime @default(now()) @map("due_date")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_goals")
}

model Quiz {
  id             String       @id @default(cuid())
  title          String
  subjectId      String?      @map("subject_id")
  totalQuestions Int          @default(10) @map("total_questions")
  createdAt      DateTime     @default(now()) @map("created_at")
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quizResults    QuizResult[]

  @@map("quizzes")
}

model QuizResult {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  quizId         String   @map("quiz_id")
  score          Int
  totalQuestions Int      @default(10) @map("total_questions")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_results")
}

model StudySession {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  durationMin Int      @map("duration_min")
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_sessions")
}

model VideoChapter {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  title     String
  startSec  Int      @map("start_sec")
  endSec    Int      @map("end_sec")
  order     Int      @default(1)
  isPremium Boolean  @default(false) @map("is_premium")

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_chapters")
}

model SubscriptionSubject {
  id             String @id @default(cuid())
  subscriptionId String @map("subscription_id")
  subjectId      String @map("subject_id")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, subjectId])
  @@map("subscription_subjects")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subjectId String   @map("subject_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("cart_items")
}

model Chat {
  id         String    @id @default(cuid())
  studentId  String    @map("student_id")
  teacherId  String    @map("teacher_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  student    User      @relation("StudentChats", fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher   @relation("TeacherChats", fields: [teacherId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@unique([studentId, teacherId])
  @@map("chats")
}

model Message {
  id         String   @id @default(cuid())
  chatId     String   @map("chat_id")
  senderId   String   @map("sender_id")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model VideoQuestion {
  id        String   @id @default(cuid())
  videoId   String   @map("video_id")
  text      String
  options   String   // JSON string of options
  answer    String
  createdAt DateTime @default(now()) @map("created_at")

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("video_questions")
}

