generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum Grade {
  GRADE_11
  GRADE_12
}

enum Branch {
  SCIENTIFIC
  LITERARY
}

enum PlanType {
  TRIAL
  MONTHLY
  QUARTERLY
  YEARLY
}

enum VideoStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String?
  grade        Grade?
  branch       Branch?
  role         UserRole @default(STUDENT)
  parentPhone  String?  @map("parent_phone")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  videoViews    VideoView[]
  teacher       Teacher?

  @@map("users")
}

model Teacher {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  name           String
  bio            String?
  commissionRate Float    @default(0.25) @map("commission_rate")
  createdAt      DateTime @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects Subject[]
  videos   Video[]

  @@map("teachers")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  grade     Grade
  branch    Branch
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  teacher Teacher? @relation(fields: [teacherId], references: [id])
  videos  Video[]

  @@unique([name, grade, branch])
  @@map("subjects")
}

model Video {
  id          String      @id @default(cuid())
  subjectId   String      @map("subject_id")
  teacherId   String?     @map("teacher_id")
  title       String
  description String?
  streamUrl   String?     @map("stream_url")
  durationSec Int         @default(0) @map("duration_sec")
  unitNumber  Int         @default(1) @map("unit_number")
  orderInUnit Int         @default(1) @map("order_in_unit")
  maxViews    Int         @default(3) @map("max_views")
  downloadDays Int        @default(7) @map("download_days")
  status      VideoStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher    Teacher?    @relation(fields: [teacherId], references: [id])
  videoViews VideoView[]

  @@map("videos")
}

model VideoView {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  videoId     String   @map("video_id")
  viewCount   Int      @default(0) @map("view_count")
  completed   Boolean  @default(false)
  lastViewed  DateTime @default(now()) @map("last_viewed")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@map("video_views")
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  type            PlanType @unique
  nameAr          String   @map("name_ar")
  durationDays    Int      @map("duration_days")
  discountPercent Float    @default(0) @map("discount_percent")
  priceIls        Float    @map("price_ils")
  videosPerSubject Int     @default(10) @map("videos_per_subject")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  planId    String   @map("plan_id")
  startDate DateTime @default(now()) @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(true) @map("is_active")
  isFrozen  Boolean  @default(false) @map("is_frozen")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, code])
  @@map("otp_codes")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
